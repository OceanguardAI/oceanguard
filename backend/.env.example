# OceanGuard backend configuration. Copy to backend/.env and fill in real values.
# backend/.env is gitignored; never commit keys.
#
# Without any keys every agent route still answers through deterministic
# fallback logic, so the dashboard works offline.

# --- Groq agents (https://console.groq.com/keys) ---
GROQ_API_KEY=
# Any Groq chat model with tool use; re-run backend/tests/test_agents.py and a
# manual briefing/ask check after changing it.
GROQ_MODEL=openai/gpt-oss-120b
# "low" | "medium" | "high" for reasoning models such as gpt-oss; empty to omit.
GROQ_REASONING_EFFORT=low

# --- Sentinel-1 SAR imagery (Copernicus Data Space Ecosystem free tier) ---
# Register at: https://dataspace.copernicus.eu -> User Settings -> OAuth Clients
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# --- On-demand YOLO verification service ---
# Leave empty to hide the "Run YOLO check" button.
# docker compose --profile yolo up  ->  http://yolo:8080
# uvicorn started by hand           ->  http://localhost:8081
YOLO_SERVICE_URL=

# --- Live data ingestion ---
# Global Fishing Watch API token: https://globalfishingwatch.org/our-apis/tokens
GFW_API_TOKEN=
# GFW dataset served to the SAR activity layer. Pinned to v4.0 because ":latest"
# re-points to data pipeline v5 on 2026-10-21 (v4 stops receiving updates then).
# Switch to :v5.0 deliberately after the comparison in docs/gfw-v5-migration.md.
GFW_SAR_DATASET=public-global-sar-presence:v4.0
# Shared secret required (header X-API-Key) on POST /ingest/push and /ingest/gfw.
# Leave empty only for local development; set it on any reachable deployment.
ADMIN_API_KEY=
# AISStream.io real-time AIS key (optional): https://aisstream.io
AISSTREAM_API_KEY=
# Monitored area bbox as JSON [min_lon,min_lat,max_lon,max_lat] (default Bar Reef, Sri Lanka)
GFW_REGION_BBOX=[79.4,8.0,79.9,8.8]
GFW_LOOKBACK_DAYS=90
GFW_INGEST_ON_STARTUP=true

# Optional PostgreSQL/PostGIS persistence. Apply migrations first:
#   python -m app.store.migrate
# Works with any PostGIS-capable Postgres (local container, Azure, Neon, ...).
DATABASE_URL=

# Optional runtime overrides (defaults live in app/core/config.py)
# AGENT_MAX_TOOL_ROUNDS=5
# AGENT_NARRATOR_MAX_TOKENS=500
# AGENT_BRIEFING_MAX_TOKENS=600
# AGENT_PATROL_MAX_TOKENS=600
# AGENT_ASK_MAX_TOKENS=700
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
